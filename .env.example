# How long cards stay cached, in seconds (default 86400 = 24h).
# Lower = livelier decay, more API calls. 21600 (6h) is a good middle ground.
# Clamped to 300..604800.
PULSE_CACHE_SECONDS=86400

# Optional but strongly recommended.
# Without it, github-pulse falls back to GitHub's unauthenticated REST API
# (60 requests/hour, recent public events only). With it, you get the full
# 365-day contribution calendar via GraphQL (5,000 requests/hour).
# Create one at https://github.com/settings/tokens — no scopes needed (public data).
GITHUB_TOKEN=

# Optional. Activates the durable features: medical record, hearts counter,
# Wall of Hearts, and watch webhooks. Without it those degrade honestly
# (record falls back to instance memory, wall/counter/watch stay off).
# Free DB at https://console.upstash.com — or add the Upstash integration
# from the Vercel marketplace, whose KV_REST_API_URL/TOKEN names work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Locks /api/watch/sweep to Vercel's cron (it sends
# `Authorization: Bearer $CRON_SECRET`). Any long random string.
CRON_SECRET=
